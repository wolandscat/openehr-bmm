import org.openehr:representation ;
import org.openehr:foundation ;

|
| Demographic registry container.
|
class REGISTRY
    is_a LOCATABLE

feature_group ("access")

    |
    | The content extracted and serialised from the source repository for this Extract.
    |
    prop parties : List<OBJECT_REF<PARTY>> ;

end