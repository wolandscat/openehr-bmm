|
| Enumeration of possible lifecycle states of any part of the terminology.
|
enumeration TERMINOLOGY_STATUS
    base_type String

values

    |
    | Terminology element is in Trial state.
    |
    trial ("trial");

    |
    | Terminology element is in Active state, i.e. published and in use.
    |
    active ("active");

    |
    | Terminology element has been Retired, i.e. deprecated.
    |
    retired ("retired");

end
