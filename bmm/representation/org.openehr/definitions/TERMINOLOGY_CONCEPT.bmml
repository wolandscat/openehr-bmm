|
| A single terminology concept in a vocabulary.
|
class TERMINOLOGY_CONCEPT

feature_group ("access")

    |
    | The code of this concept.
    |
    prop id : String ;

    |
    | The rubric, i.e. linguistic expression, of this concept, in the language of this
    | terminology instance.
    |
    prop rubric : String ;

    |
    | Status of this concept within the vocabulary.
    |
    prop status :? TERMINOLOGY_STATUS ;

end
