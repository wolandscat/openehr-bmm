|
| A single code entity in a code set.
|
class CODE

feature_group ("access")

    |
    | The code string for this code entity, e.g. `"AF"`.
    |
    prop value : String ;

    |
    | Optional description of this code, e.g. `"AFGHANISTAN"`.
    |
    | This field may be used to hold translations of the description in a language-specific
    | copy of the English language original code set.
    |
    prop description :? String ;

    |
    | Status of this code within the code set.
    |
    prop status :? TERMINOLOGY_STATUS ;

end
