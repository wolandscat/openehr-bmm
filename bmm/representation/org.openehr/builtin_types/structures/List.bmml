|
| Ordered container that may contain duplicates.
|
builtin class List<V>
    is_a Container<V>

feature_group ("access")

    |
    | Return first element.
    |
    func first : V ;

    |
    | Return last element.
    |
    func last : V ;
    
    |
    | Return nth item in container. The value n is 1-based.
    |
    func item(n: Integer) : V
        pre_cond
            index_valid: n > 0 ∧ n <= count;
        ;

feature_group ("transform")

    func zip (other: List<Any>): List<Pair<V, Any>>
        ;
        
invariant
    first_validity: ¬is_empty ⇒ ∃first;
    last_validity: ¬is_empty ⇒ ∃last;

end