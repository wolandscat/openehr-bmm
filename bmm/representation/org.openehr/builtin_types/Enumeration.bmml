|
| Abstract ancestor of all enumerations, over their base type `T` (`Integer` or `String`):
| each enumeration inherits from it implicitly.
|
abstract builtin class Enumeration<T>

feature_group ("validation")

    |
    | The values of the enumeration, in order.
    |
    func value_list: List<T> ;

    |
    | True if `v` is one of the values of the enumeration.
    |
    func valid_value (v: T): Boolean
        post_cond
            validity: Result = value_list ().has (v);
        ;

end
