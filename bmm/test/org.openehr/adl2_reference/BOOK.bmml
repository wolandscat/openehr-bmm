import org.openehr:representation;

|
| Syntax-demonstration class, converted from the ADLtest `openehr_adltest_100.bmm` ODIN
| schema.
|
class BOOK

feature_group ("access")

    prop author : String ;

    prop title : String ;

    prop chapters :? List<CHAPTER> ;

end
