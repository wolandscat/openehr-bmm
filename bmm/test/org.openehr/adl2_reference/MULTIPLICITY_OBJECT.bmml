import org.openehr:representation;

|
| Syntax-demonstration class, converted from the ADLtest `openehr_adltest_100.bmm` ODIN
| schema. Illustrates container properties of primitive leaf types.
|
class MULTIPLICITY_OBJECT

feature_group ("access")

    prop integer_list :? List<Integer> ;

    prop string_list :? List<String> ;

end
