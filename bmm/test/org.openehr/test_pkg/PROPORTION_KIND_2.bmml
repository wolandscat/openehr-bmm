|
| Syntax-demonstration enumeration, converted from the ODIN `EXAMPLE.bmm` reference
| schema. An Integer-based enumeration with explicit item values.
|
enumeration PROPORTION_KIND_2
    base_type Integer

feature_group ("values")

    pk_ratio (0);

    pk_unitary (1001);

    pk_percent (1002);

    pk_fraction (1003);

    pk_integer_fraction (1004);

end
