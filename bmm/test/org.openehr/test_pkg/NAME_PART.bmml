|
| Syntax-demonstration enumeration, converted from the ODIN `EXAMPLE.bmm` reference
| schema. A String-based enumeration whose source left item values unspecified, so
| each value defaults to its item name.
|
enumeration NAME_PART
    base_type String

feature_group ("values")

    first ("FIRST");

    middle ("MIDDLE");

    last ("LAST");

end
