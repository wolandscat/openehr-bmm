import org.openehr:representation;

|
| Syntax-demonstration class, converted from the ADLtest `openehr_adltest_100.bmm` ODIN
| schema. Inherits from `GENERIC_PARENT`, leaving its first generic parameter open
| (re-declared here as `T`) while closing the second to `SUPPLIER_B`.
|
class GENERIC_CHILD_OPEN_T<T: SUPPLIER>
    is_a GENERIC_PARENT<T, SUPPLIER_B>

feature_group ("access")

    prop gen_child_open_t_prop :? String ;

end
