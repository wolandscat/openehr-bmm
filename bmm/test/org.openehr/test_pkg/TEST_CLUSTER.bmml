|
| Syntax-demonstration class, converted from the ADLtest `openehr_adltest_100.bmm` ODIN
| schema. Illustrates a mandatory container property.
|
class TEST_CLUSTER
    is_a TEST_ITEM

feature_group ("access")

    |
    | List of contained `TEST_ITEM`s.
    |
    prop items : List<TEST_ITEM> ;

end
