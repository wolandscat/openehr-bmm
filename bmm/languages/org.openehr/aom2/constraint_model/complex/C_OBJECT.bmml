import org.openehr:representation;

|
| Abstract model of constraint on any kind of object node.
|
abstract class C_OBJECT
    is_a ARCHETYPE_CONSTRAINT

feature_group ("access")

    |
    | Reference model type that this node corresponds to.
    |
    prop rm_type_name : String ;

    |
    | Occurrences of this object node in the data, under the owning attribute. Upper limit can
    | only be greater than 1 if owning attribute has a cardinality of more than 1. Only set if
    | it overrides the parent archetype in the case of specialised archetypes, or else the
    | occurrences inferred from the underlying reference model existence and/or cardinality of
    | the containing attribute.
    |
    prop occurrences :? Multiplicity_interval ;

    |
    | Semantic identifier of this node, used to distinguish sibling nodes. All nodes must have a
    | `node_id`; for nodes under a container `C_ATTRIBUTE`. For at-coded archetypes
    | `node_id` must be an at-code defined in the archetype terminology and for valid
    | structures all node ids are at-codes. For id-coded archetypes `node_id` must be an id-
    | code defined in the archetype terminology and for valid structures all node ids are id-
    | codes.
    |
    | For `C_PRIMITIVE_OBJECTs` represented in ADL inline form, this attribute will have the
    | special value `Primitive_node_id`; otherwise it will have the node id read during parsing.
    |
    prop node_id : String ;

    |
    | Additional identifiers of this node. openEHR archetypes can carry original ALD2 id-codes
    | in this attribute and it can also carry human readable codes for future use. Alternative
    | ids must be unique within the archetype.
    |
    prop alternative_ids :? List<String> ;

    |
    | Optional indicator of order of this node with respect to another sibling. Only meaningful
    | in a specialised archetype for a `C_OBJECT` within a `C_ATTRIBUTE` with `is_multiple_ =
    | True`.
    |
    prop sibling_order :? SIBLING_ORDER ;

    |
    | Level of specialisation of this archetype node, based on its `node_id`. The value 0
    | corresponds to non-specialised, 1 to first-level specialisation and so on. The level is
    | the same as the number of '.' characters in the node_id code. If `node_id` is not set,
    | the return value is -1, signifying that the specialisation level should be determined from
    | the nearest parent `C_OBJECT` node having a node_id.
    |
    func specialisation_depth : Integer ;

    |
    | Compute effective occurrences, where no local occurrences constraint set. If the owning
    | `C_ATTRIBUTE._cardinality` is set, use its upper value, else use RM multiplicity of the
    | owning attribute.
    |
    | If local `occurrences` not set, always assume 0 as the lower bound.
    |
    func effective_occurrences (rm_prop_mult: (String, String) -> Multiplicity_interval): Multiplicity_interval
        do
            Result :=
                when
                ===============================================================================
                ∃occurrences -> occurrences,
                -------------------------------------------------------------------------------
                ∃parent      -> when
                                ================================================================
                                ∃parent.cardinality ->
                                    when
                                    ============================================================
                                    parent.cardinality.
                                    interval.
                                    upper_unbounded    ->  Multiplicity_interval.make_open,
                                    ------------------------------------------------------------
                                    *                  ->  Multiplicity_interval.make_bounded
                                                           (0,parent.cardinality.interval.upper)
                                    ============================================================
                                    ,
                                ----------------------------------------------------------------
                                ∃parent.parent   -> rm_prop_mult (parent.parent.rm_type_name,
                                                    parent.parent.rm_attribute_path),
                                ----------------------------------------------------------------
                                *                -> Multiplicity_interval.make_open
                                =================================================================
                                ,
                ---------------------------------------------------------------------------------
                *          -> Multiplicity_interval.make_open
                =================================================================================
                ;
        ;

feature_group ("status")

    |
    | True if this node and by implication all sub-nodes are deprecated for use.
    |
    prop is_deprecated :? Boolean ;

    |
    | True if this `C_OBJECT` node is prohibited, i.e. if its `occurrences` is `0..0`.
    |
    func is_prohibited : Boolean
        do
            Result := ∃occurrences ∧ occurrences.is_prohibited;
        post_cond
            result_valid: Result = ∃occurrences ∧ occurrences.is_prohibited;
        ;

feature_group ("comparison")

    |
    | True if constraints represented by this node, ignoring any sub-parts, are narrower or the
    | same as other. Typically used during validation of specialised archetype nodes.
    |
    | Parameters
    |   `rmcc`:: Reference Model conformance checker agent (lambda).
    | 
    | Returns True when the following is True:
    |   * rm_type_name is the same or a subtype of rm_type_name of other;
    |   * node_id is the same, or redefined to a legal code at the level of the owning archetype
    |   * is_root or else
    |     parent.is_multiple or else -- we do the real check from the parent C_ATTRIBUTE
    |     parent.is_single and
    |     occurrences is same (= Void) or a sub-interval
    |
    func c_conforms_to (other : C_OBJECT, rmcc: (String, String) -> Boolean) : Boolean
        do
            Result := node_id_conforms_to (other) ∧
                (rm_type_name.is_case_insensitive_equal (other.rm_type_name) ∨
                rmcc (rm_type_name, other.rm_type_name)) ∧
                (is_root ∨ parent.is_multiple ∨ parent.is_single ∧ occurrences_conforms_to (other));
        ;

    |
    |  True if this node on its own (ignoring any subparts) expresses no constraints in addition
    |  to `other', other than possible redefinition of the node id, which doesn't matter, since
    |  this won't get lost in a compressed path.
    |  Current and `other' are typically from flat archetypes being compared to generate a diff.
    |  Used to determine if path segments can be compressed.
    |  Returns True if:
    | 	 * rm_type_name is identical
    | 	 * occurrences is Void or else identical to other.occurrences
    |  	 * sibling_order is Void or else identical to other.sibling_order
    | 	 * node_id is identical or else is the only child that overlays the parent node
    |
    func c_congruent_to (other : ARCHETYPE_CONSTRAINT) : Boolean
        do
            Result := rm_type_name.is_case_insensitive_equal (other.rm_type_name) ∧
                (¬∃occurrences ∨ (∃other.occurrences ∧
                    occurrences.is_equal (other.occurrences))) ∧
                (¬∃sibling_order ∨ (∃other.sibling_order ∧
                    sibling_order.is_equal (other.sibling_order))) ∧
                node_reuse_congruent (other);
        ;

    |
    | True if this node `occurrences` conforms to `other.occurrences`; `other` is assumed to
    | be in a flat archetype. Only redefinitions of single-occurrence nodes can be dealt with here;
    | redefinitions of multiply-occurrences nodesmust be evaluated at the owning attribute,
    | according to VSONCO.
    |
    | .Parameters +
    | `other`:: `C_OBJECT` from a flat parent archetype.
    |
    func occurrences_conforms_to (other : C_OBJECT) : Boolean
        do
            Result := ∃occurrences ∧ other.occurrences.upper = 1 ?
                other.occurrences.contains (occurrences) : True;
        ;

    |
    | True if this node id conforms to `other.node_id`, which includes the ids being
    | identical; `other` is assumed to be in a flat archetype.
    |
    func node_id_conforms_to (other : C_OBJECT) : Boolean
        do
            Result := codes_conformant (node_id, other.node_id);
        post_cond
            result_valid: Result = codes_conformant (node_id, other.node_id);
        ;

    |
    | True if this node is the sole re-using node of the corresponding node in the flat.
    |
    func node_reuse_congruent (other: C_OBJECT): Boolean
        do
            Result := node_id_conforms_to (other) ∧
                (is_root ∨ ∃parent ∧ parent.child_reuse_count (other.node_id) = 1);
        ;

end
